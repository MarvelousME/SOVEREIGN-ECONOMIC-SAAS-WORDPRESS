# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubi_cms
DB_USER=ubi_user
DB_PASSWORD=ubi_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# NATS
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=ubi-cms-cluster

# Logging
LOG_LEVEL=info

# Service
SERVICE_NAME=ledger-service
SERVICE_VERSION=1.0.0
