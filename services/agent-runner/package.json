{
  "name": "agent-runner",
  "version": "1.0.0",
  "description": "AI Agent Runner - Agent execution engine with memory and storage",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "nats": "^2.20.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.1",
    "@qdrant/js-client-rest": "^1.8.2",
    "minio": "^7.1.3",
    "axios": "^1.6.2",
    "bullmq": "^5.1.5",
    "@temporalio/worker": "^1.9.0",
    "@temporalio/activity": "^1.9.0",
    "vm2": "^3.9.19",
    "openai": "^4.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/minio": "^7.1.1",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
