PORT=3020
NODE_ENV=development
SERVICE_NAME=compliance-engine
SERVICE_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubi_cms
DB_USER=ubi_user
DB_PASSWORD=ubi_password
DB_POOL_MIN=2
DB_POOL_MAX=10

NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=ubi-cms-cluster

LOG_LEVEL=info

CONSENT_EXPIRATION_DAYS=365
REVIEW_QUEUE_HIGH_PRIORITY_THRESHOLD=70
ABUSE_SCORE_BLOCK_THRESHOLD=80
GEO_RESTRICTION_CACHE_MINUTES=60
