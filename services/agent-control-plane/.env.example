# Server Configuration
NODE_ENV=development
AGENT_CONTROL_PLANE_PORT=3010

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ubinexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS Configuration
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

# OPA Configuration
OPA_URL=http://localhost:8181
OPA_POLICY=agent_control_plane

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ubinexus
KEYCLOAK_CLIENT_ID=agent-control-plane
KEYCLOAK_CLIENT_SECRET=

# Service URLs
LEDGER_SERVICE_URL=http://localhost:3003
TASK_MARKETPLACE_URL=http://localhost:3004
AGENT_RUNNER_URL=http://localhost:3011

# Default Resource Limits
DEFAULT_MAX_CPU=1
DEFAULT_MAX_MEMORY_MB=512
DEFAULT_MAX_STORAGE_MB=1024
DEFAULT_MAX_API_CALLS=60
DEFAULT_MAX_TOKENS=100000
DEFAULT_MAX_COST=10

# Agent Configuration
MAX_AGENT_CODE_SIZE=1048576
MAX_AGENT_NAME_LENGTH=255
MAX_AGENT_DESC_LENGTH=1000
MAX_AGENT_VERSIONS=10

# Deployment Configuration
DEFAULT_DEPLOYMENT_STRATEGY=direct
CANARY_DEFAULT_PERCENT=10
MAX_ROLLOUT_DURATION=3600000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
