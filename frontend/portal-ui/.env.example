# ─── UBI Portal UI — Environment Variables ──────────────────────────────────
# Copy to .env.local for local development, or inject as build args in Docker.

# Backend API base URL (must include /api/v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# WebSocket URL (same host as API, no path suffix)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_WEBSOCKET=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
