# Copy into business-builder `.env` (or Compose env) so every **new** tenant workspace
# is created with `tenant_workspaces.settings.treasury` pointing at the single platform vault.
#
# Defaults match `seeds/001_seed_development_data.sql`:
#   tenants.id = 1 (ACME), treasury_vaults.id = 1 (Operational Vault)
#
# After changing IDs, run migration `022_tenant_workspace_main_treasury.sql` logic manually
# or re-merge settings on existing rows if your seed uses different IDs.

MAIN_TREASURY_PLATFORM_TENANT_ID=1
MAIN_TREASURY_VAULT_ID=1
