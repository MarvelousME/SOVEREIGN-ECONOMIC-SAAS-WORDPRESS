# Optional: POST JSON when a page is published (e.g. n8n, Zapier) — { event, pageId, tenantId, urls, shareLinks, targetTypes }
# SOCIAL_PUBLISH_WEBHOOK_URL=https://example.com/hooks/page-published

# Required for native social OAuth + publishing
# Base64 encoded 32-byte AES key for encrypting social access tokens
# Example generation (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
# SOCIAL_TOKEN_ENCRYPTION_KEY=

# Queue backend for scheduling/retries/dead-letter
# REDIS_URL=redis://127.0.0.1:6379

# OAuth callback base URL (service public base), callback path auto-appended:
# /api/v1/social/oauth/:provider/callback
# SOCIAL_OAUTH_REDIRECT_BASE_URL=http://localhost:3011

# X (Twitter) OAuth
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Meta (Facebook Pages) OAuth
# META_APP_ID=
# META_APP_SECRET=

# TikTok OAuth + publish bridge (Phase 2)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_PUBLISH_WEBHOOK_URL=
# TIKTOK_PUBLISH_BRIDGE_URL=

# Optional analytics integration endpoint root (for social.publish -> attribution touchpoints)
# ANALYTICS_SERVICE_URL=http://localhost:3020

# Optional UBI rewards sink. When configured, reward events are POSTed here.
# If request fails (or this is not configured), reward events are emitted through the internal event publisher fallback.
# UBI_REWARDS_ENDPOINT_URL=https://example.com/rewards/events
# UBI_REWARDS_API_TOKEN=
