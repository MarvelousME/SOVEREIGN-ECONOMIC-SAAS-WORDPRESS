# Server Configuration
NODE_ENV=development
AGENT_RUNNER_PORT=3011

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ubinexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# Redis Configuration (Short-term memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=3600

# Qdrant Configuration (Long-term vector memory)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=agent

# MinIO Configuration (Artifact storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-artifacts

# NATS Configuration
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-execution

# OPA Configuration
OPA_URL=http://localhost:8181
OPA_POLICY=agent_runner

# Ledger Service Configuration
LEDGER_SERVICE_URL=http://localhost:3003

# OpenAI Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096

# Execution Configuration
DEFAULT_EXECUTION_TIMEOUT=300000
MAX_EXECUTION_TIMEOUT=3600000
MAX_CONCURRENT_EXECUTIONS=100
CHECKPOINT_INTERVAL=30000

# Sandbox Configuration
SANDBOX_ALLOWED_MODULES=crypto,util,buffer,querystring,url,stream
SANDBOX_ALLOWED_GLOBALS=console,setTimeout,setInterval,Promise,JSON,Math,Date
SANDBOX_MEMORY_LIMIT=512

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CHECK_INTERVAL=10000

# Memory Configuration
SHORT_TERM_MEMORY_TTL=3600
LONG_TERM_MAX_RESULTS=10
EPISODIC_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
