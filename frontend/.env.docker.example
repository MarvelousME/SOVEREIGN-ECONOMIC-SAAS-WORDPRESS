# API Configuration
NEXT_PUBLIC_API_URL=http://api:8000
NEXT_PUBLIC_WS_URL=ws://api:8000

# Portal UI Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Admin UI Configuration
ADMIN_NEXTAUTH_URL=http://localhost:3001
ADMIN_NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Keycloak Configuration (Portal)
KEYCLOAK_CLIENT_ID=ubi-portal
KEYCLOAK_CLIENT_SECRET=your-portal-client-secret
KEYCLOAK_ISSUER=http://keycloak:8080/realms/ubi-platform

# Keycloak Configuration (Admin)
ADMIN_KEYCLOAK_CLIENT_ID=ubi-admin
ADMIN_KEYCLOAK_CLIENT_SECRET=your-admin-client-secret
