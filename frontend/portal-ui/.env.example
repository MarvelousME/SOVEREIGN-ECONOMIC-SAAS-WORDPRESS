# ─── UBI Portal UI — Environment Variables ──────────────────────────────────
# Copy to .env.local for local development, or inject as build args in Docker.

# Backend API base URL (must include /api/v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# WebSocket URL (same host as API, no path suffix)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_WEBSOCKET=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# System Architecture API (server-side only — add to .env.local, not NEXT_PUBLIC_*)
# Optional: require x-architecture-secret header (paste same value in UI session field)
# ARCHITECTURE_WRITE_SECRET=
# Allow POST /api/architecture/apply to run docker compose (dangerous — dev only)
# ARCHITECTURE_ALLOW_APPLY=true
