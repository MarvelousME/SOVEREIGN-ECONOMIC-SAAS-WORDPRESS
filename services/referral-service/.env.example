NODE_ENV=development
PORT=3007

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubi_cms
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222

# Referral Settings
REFERRAL_CODE_LENGTH=8
REFERRAL_COOKIE_DAYS=30
MAX_REFERRAL_TIERS=5

# Tier Percentages (basis points - 1000 = 10%)
TIER_1_PERCENTAGE=1000
TIER_2_PERCENTAGE=500
TIER_3_PERCENTAGE=300
TIER_4_PERCENTAGE=200
TIER_5_PERCENTAGE=100

# Fraud Detection
MAX_REFERRALS_PER_IP=5
MAX_REFERRALS_PER_DEVICE=3
SUSPICIOUS_VELOCITY_MINUTES=60
SUSPICIOUS_VELOCITY_COUNT=10

# Milestone Bonuses
MILESTONE_10_BONUS=100
MILESTONE_50_BONUS=500
MILESTONE_100_BONUS=1000

# Max Rewards
MAX_REWARD_PER_REFEREE=1000
MAX_DAILY_PAYOUT=10000
