# Server Configuration
PORT=3005
NODE_ENV=development

# Database
DATABASE_URL=postgresql://ubi_user:ubi_password@localhost:5432/ubi_cms
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubi_cms
DB_USER=ubi_user
DB_PASSWORD=ubi_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# NATS
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=ubi-cluster

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Service Configuration
SERVICE_NAME=task-marketplace
LOG_LEVEL=info

# Task Configuration
TASK_EXPIRY_DAYS=30
MAX_TASKS_PER_USER=100
MIN_REPUTATION_FOR_EXPERT_TASKS=500
DISPUTE_RESOLUTION_TIMEOUT_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
