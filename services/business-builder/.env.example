# Server Configuration
PORT=3007
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubi_cms
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
# Optional claim: tenantId (workspace UUID). Clients may send X-Tenant-Id instead.

# Tenant isolation (workspaces)
# Default workspace UUID after migrations/012 (see src/constants/tenant.ts)
DEFAULT_WORKSPACE_ID=e0000000-0000-4000-8000-000000000001
# Internal provisioning API (min 16 chars). Header: X-Provision-Key
PROVISION_API_KEY=change-me-provision-key-32chars-min

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Logging
LOG_LEVEL=info

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (Optional)
SENDGRID_API_KEY=your_sendgrid_key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# Domain Configuration
BASE_DOMAIN=yourdomain.com
SUBDOMAIN_SUFFIX=.app.yourdomain.com

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Feature Flags
ENABLE_AI_BRANDING=true
ENABLE_LOGO_GENERATION=true
ENABLE_AUTO_SSL=true
