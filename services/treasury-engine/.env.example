# Server
PORT=3004
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=treasury_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# NATS
NATS_URL=nats://localhost:4222

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# OPA
OPA_URL=http://localhost:8181

# Treasury
DEFAULT_COMPOUNDING_FREQUENCY=daily
REBALANCE_DRIFT_THRESHOLD=0.05
MAX_WITHDRAWAL_DAILY=1000000
EMERGENCY_PAUSE=false

# Ledger Service
LEDGER_SERVICE_URL=http://localhost:3001

# Logging
LOG_LEVEL=info
