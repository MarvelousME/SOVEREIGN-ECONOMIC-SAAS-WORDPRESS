# ─── UBI CMS — Production Environment Template ──────────────────────────────
# Copy to .env.production and fill in all values before deploying.
# NEVER commit .env.production to source control.

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ubi_production
DB_USER=ubi_app
DB_PASSWORD=CHANGE_ME_strong_db_password_here
DATABASE_URL=postgresql://ubi_app:CHANGE_ME_strong_db_password_here@postgres:5432/ubi_production

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here

# ── JWT / Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRY=1h

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://portal.ubi-platform.com,https://admin.ubi-platform.com

# ── Frontend public URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.ubi-platform.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.ubi-platform.com

# ── Docker image tags (set in CI or leave as :latest) ───────────────────────
API_IMAGE=ubi-api:latest
PORTAL_IMAGE=ubi-portal-ui:latest

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
