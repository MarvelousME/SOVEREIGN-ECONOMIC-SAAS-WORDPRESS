# UBI-CMS Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# Database Configuration
# ==========================================
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=ubi_cms
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=changeme
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ==========================================
# MinIO Configuration
# ==========================================
MINIO_USER=admin
MINIO_PASSWORD=changeme123456
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# ==========================================
# NATS Configuration
# ==========================================
NATS_URL=nats://nats:4222

# ==========================================
# Keycloak Configuration
# ==========================================
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_HOSTNAME=auth.yourdomain.com
KEYCLOAK_REALM=ubi-cms

# ==========================================
# SSL/TLS Configuration
# ==========================================
LETSENCRYPT_EMAIL=admin@yourdomain.com
DOMAIN=yourdomain.com

# ==========================================
# Monitoring Configuration
# ==========================================
GRAFANA_PASSWORD=changeme
PROMETHEUS_RETENTION_TIME=30d

# ==========================================
# Backup Configuration
# ==========================================
BACKUP_DIR=/var/backups/ubi-cms
RETENTION_DAYS=30
S3_BUCKET=ubi-cms-backups
AWS_REGION=us-east-1

# ==========================================
# Deployment Configuration
# ==========================================
ENVIRONMENT=development
IMAGE_TAG=latest
REGISTRY=ghcr.io
IMAGE_PREFIX=your-org/ubi-cms

# ==========================================
# Notification Configuration
# ==========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# JWT
JWT_SECRET=changeme-generate-random-secret
JWT_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Traefik gateway (docker-compose.dev / prod / staging gateway service)
# ==========================================
# Host path to the container runtime API socket, mounted at /var/run/docker.sock in Traefik.
# Docker Engine (default): /var/run/docker.sock
# Podman rootful (Linux): /run/podman/podman.sock
# Podman rootless: $XDG_RUNTIME_DIR/podman/podman.sock (expand before compose, e.g. /run/user/1000/podman/podman.sock)
# TRAEFIK_PLATFORM_SOCKET=/var/run/docker.sock
# OTLP HTTP traces endpoint for Traefik (override if collector is not otel-collector:4318)
# TRAEFIK_TRACING_OTLP_HTTP_ENDPOINT=http://otel-collector:4318/v1/traces

# ==========================================
# Feature Flags
# ==========================================
FEATURE_FLAG_NEW_UBI_ENGINE=false
FEATURE_FLAG_ADVANCED_REPORTING=false

# ==========================================
# Optional local extras (docker-compose.local-extras.yml)
# Start with: docker compose -f docker-compose.local-extras.yml up -d
# Or: scripts/bootstrap-local-extras.ps1 / scripts/bootstrap-local-extras.sh
# ==========================================
# OPENSEARCH_URL=http://localhost:9200
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAILHOG_UI=http://localhost:8025
