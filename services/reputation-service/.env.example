# Reputation Service Configuration

# Server
PORT=3002
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ubi_cms

# Redis
REDIS_URL=redis://localhost:6379

# NATS Event Bus
NATS_URL=nats://localhost:4222

# Service URLs
REWARDS_SERVICE_URL=http://localhost:3003

# JWT Secret (for authentication)
JWT_SECRET=your-secret-key-here

# Reputation Scoring Weights
TASK_VOLUME_WEIGHT=0.4
TASK_COMPLETION_WEIGHT=0.6
APPROVAL_RATE_WEIGHT=0.5
QUALITY_RATING_WEIGHT=0.5
ON_TIME_DELIVERY_WEIGHT=0.7
CONSISTENCY_WEIGHT=0.3
ENDORSEMENT_WEIGHT=0.6
COMMUNITY_CONTRIBUTION_WEIGHT=0.4

# Decay Settings
DECAY_RATE=0.005
ACTIVITY_THRESHOLD_DAYS=30
MIN_DECAY_RETENTION=0.5

# Fraud Detection Thresholds
SPIKE_THRESHOLD=3.0
MIN_REVIEW_VARIANCE=0.15
SYBIL_SIMILARITY_THRESHOLD=0.85
RAPID_GROWTH_THRESHOLD=0.5

# Cache TTL (seconds)
REPUTATION_CACHE_TTL=60
LEADERBOARD_CACHE_TTL=300

# Logging
LOG_LEVEL=info
LOG_FILE=reputation-service.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50
ENDORSEMENT_RATE_LIMIT=5
