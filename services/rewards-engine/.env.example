# Rewards Engine Service Configuration

# Server
PORT=3003
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ubi_cms

# Redis
REDIS_URL=redis://localhost:6379

# NATS Event Bus
NATS_URL=nats://localhost:4222

# Service URLs
REPUTATION_SERVICE_URL=http://localhost:3002
LEDGER_SERVICE_URL=http://localhost:3001

# JWT Secret (for authentication)
JWT_SECRET=your-secret-key-here

# Reward Pool Settings
TASK_POOL_ALLOCATION=1000000
REFERRAL_POOL_ALLOCATION=250000
LOYALTY_POOL_ALLOCATION=100000

# Multiplier Limits
MAX_REPUTATION_MULTIPLIER=2.0
MAX_LOYALTY_MULTIPLIER=1.5
MAX_STAKING_MULTIPLIER=1.3
MAX_VOLUME_MULTIPLIER=1.2

# Referral Tier Percentages
TIER_1_PERCENTAGE=10
TIER_2_PERCENTAGE=5
TIER_3_PERCENTAGE=2

# Agent Marketplace
CREATOR_SHARE_PERCENTAGE=70
PLATFORM_FEE_PERCENTAGE=30

# Logging
LOG_LEVEL=info
LOG_FILE=rewards-engine.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
