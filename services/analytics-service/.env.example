# Analytics Service Environment Variables

# Server Configuration
NODE_ENV=development
ANALYTICS_PORT=3004

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sovereign_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# ClickHouse Configuration
CH_HOST=localhost
CH_PORT=8123
CH_DATABASE=analytics
CH_USER=default
CH_PASSWORD=

# Optional: OpenSearch (local dev — repo root: docker compose -f docker-compose.local-extras.yml up -d)
# Use when wiring log/event indexing or hybrid search experiments alongside ClickHouse.
# OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INDEX_PREFIX=sovereign-analytics

# Security
JWT_SECRET=your-secret-key-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
