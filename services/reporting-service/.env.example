# Server
PORT=3008
NODE_ENV=development
SERVICE_NAME=reporting-service
SERVICE_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubi_cms
DB_USER=ubi_user
DB_PASSWORD=ubi_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Database Read Replica (for reporting queries)
DB_READ_HOST=localhost
DB_READ_PORT=5432
DB_READ_NAME=ubi_cms
DB_READ_USER=ubi_user
DB_READ_PASSWORD=ubi_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=ubi-cms-cluster

# Logging
LOG_LEVEL=info

# Features
ENABLE_EXPORT=true
ENABLE_SCHEDULED_REPORTS=true
